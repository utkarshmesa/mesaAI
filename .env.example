# Telegram. Allowed chat IDs: comma list, channel id (-100…) and/or Meera's DM chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Random 32+ chars, [A-Za-z0-9_-]  (e.g. openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=

# Gemini (the only LLM provider). IDs checked 25 Sep 2026, see docs/decisions.md
GEMINI_API_KEY=
# Analyse call (score criteria + search phrase)
GEMINI_MODEL=gemini-3.8-flash
# Drafter. Any Gemini model ID; compare two with `npm run compare -- note_01`
DRAFT_MODEL=gemini-3.8-flash

# Supabase (from M4). Leave empty to use the in-memory repo
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SCORE_THRESHOLD=6
MIN_NOTE_WORDS=12
NEWS_LOCALE=hl=en-IN&gl=IN&ceid=IN:en
NEWS_WINDOW=when:30d
